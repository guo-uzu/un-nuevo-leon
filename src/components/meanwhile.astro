---
import { Image } from "astro:assets";
import Book from "../assets/Book.png";
import UpperText from "../assets/UpperText.webp";
---

<section class="grid h-svh w-full place-items-center overflow-hidden bg-[linear-gradient(to_bottom,#d4d4d4,#e1e1e1)]">
    <!-- [container-type:inline-size] lets children use cqw = 1% of the book's width -->
    <div class="relative w-[min(35rem,78vw,55svh)] [container-type:inline-size]">
        <!-- Banner group: same anchor + rotation as before, now holding the bar AND the image -->
        <div class="absolute left-1/2 top-[-7%] z-10 w-[200%] -translate-x-1/2 -translate-y-1/2 -rotate-12 md:w-[340%]">
            <!-- Orange extension: much wider than any screen, so the ribbon always bleeds off both sides -->
            <div class="absolute left-1/2 top-[calc(50%+0.4cqw)] h-[12.1cqw] w-[300vw] -translate-x-1/2 -translate-y-1/2 bg-[#f18423] md:h-[20.5cqw] md:top-[calc(50%+0.4cqw)]"></div>
            <Image
                class="relative block w-full max-w-none lg:-left-[110px]"
                src={UpperText}
                alt="Imagen publicitaria del nuevo libro Un Nuevo León por Samuel García"
            />
        </div>

        <Image
            class="relative z-0 block h-auto w-full drop-shadow-[2.5vmin_2.5vmin_3vmin_rgba(0,0,0,0.25)]"
            src={Book}
            alt="Imagen publicitaria del nuevo libro Un Nuevo León por Samuel García"
        />
    </div>
</section>
